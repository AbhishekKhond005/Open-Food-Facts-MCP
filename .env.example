# Open Food Facts MCP Server – Configuration
# Copy to .env and fill in values. Never commit .env itself.

# Server bind settings
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8081
MCP_ENDPOINT_PATH=/mcp

# Allowed origins (comma-separated). Empty = allow requests without Origin header.
MCP_ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=info

# Open Food Facts API (public, no key needed)
OFF_API_BASE_URL=https://world.openfoodfacts.org
OFF_API_TIMEOUT_MS=10000

# Server-side request timeout in milliseconds (keep below the simulator's 20000 ms timeout)
SERVER_REQUEST_TIMEOUT_MS=15000

# Max body size in bytes
MAX_REQUEST_BODY_BYTES=1048576
